{
  "name": "transactioner",
  "private": true,
  "description": "Desktop helper for poker room transaction templates.",
  "author": "Transactioner",
  "version": "0.1.20",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && vite",
    "build": "tsc -b && vite build",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "test": "npm rebuild better-sqlite3 && vitest run && electron-rebuild -f -w better-sqlite3",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:api-keys": "node scripts/prepare-api-keys.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:release": "npm run version:bump && npm run prepare:api-keys && npm run build && electron-builder --mac && electron-builder --win --x64",
    "predist:mac": "npm run prepare:api-keys",
    "dist:mac": "npm run build && electron-builder --mac",
    "predist:win": "npm run prepare:api-keys",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.transactioner.app",
    "productName": "Transactioner",
    "directories": {
      "output": "release"
    },
    "icon": "public/icon",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "USER_RELEASE_NOTES.txt"
    ],
    "extraResources": [
      {
        "from": "build/private",
        "to": "private",
        "filter": [
          "api-keys.env"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Transactioner",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.7"
  }
}
