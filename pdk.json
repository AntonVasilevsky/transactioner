{
  "pdk": {
    "version": "0.2.0"
  },
  "name": "transactioner",
  "mode": "assisted",
  "paths": {
    "vault": "pdk",
    "knowledge": "pdk/knowledge",
    "tasks": "pdk/tasks",
    "skills": ".agents/skills"
  },
  "mandatory": [
    "pdk/knowledge/project.md",
    "pdk/knowledge/rules.md"
  ],
  "taskPrefix": "T",
